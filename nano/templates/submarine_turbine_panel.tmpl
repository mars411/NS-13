<div class="item">
	<i>This panel runs the steam turbine. Steam comes in through the admission (inlet) valve and leaves through the condenser, whose cooling sets the exhaust side. The speed governor holds the shaft at its setting by moving the admission valve; switch it off to do that by hand. The generator breaker can be closed only while the needle is in the green band. The stop valve shuts the steam off in an emergency. Keep an eye on the vibration: worn or wrecked sections and overspeed make it climb.</i>
</div>
{{if !data.linked}}
<div class='notice'>
	<b>NO LINK TO TURBINE '{{:data.turbineId}}'</b><br>
	Check that the turbine generator is built and has the same unit id.<br><br>
	{{:helper.link('Rescan links', 'refresh', {'action' : 'rescan'})}}
</div>
{{else}}
<div class="item">
	<div class="itemLabel">
		Unit:
	</div>
	<div class="itemContent">
		<b>{{:data.turbineId}}</b>
		{{if data.missing > 0}}
			<span class='bad'>&nbsp;{{:data.missing}} of 3 sections NOT FOUND</span>
		{{/if}}
	</div>
</div>

<h3>Shaft and generator</h3>
<div class="item">
	<div class="itemLabel">
		Shaft speed:
	</div>
	<div class="itemContent">
		<svg width="170" height="142" viewBox="0 0 120 100">
			<circle cx="60" cy="60" r="40" fill="none" stroke="#3a3a3a" stroke-width="9" stroke-dasharray="188.5 400" transform="rotate(135 60 60)"/>
			<circle cx="60" cy="60" r="40" fill="none" stroke="#2f7d3a" stroke-width="9" stroke-dasharray="0 {{:data.gGreenStart}} {{:data.gGreenLen}} 400" transform="rotate(135 60 60)"/>
			<circle cx="60" cy="60" r="40" fill="none" stroke="#a8841f" stroke-width="9" stroke-dasharray="0 {{:data.gAmberStart}} {{:data.gAmberLen}} 400" transform="rotate(135 60 60)"/>
			<circle cx="60" cy="60" r="40" fill="none" stroke="#a63a2f" stroke-width="9" stroke-dasharray="0 {{:data.gRedStart}} {{:data.gRedLen}} 400" transform="rotate(135 60 60)"/>
			{{if data.governorOn && data.governorOk}}
				<line x1="60" y1="9" x2="60" y2="16" stroke="#f0c040" stroke-width="3" transform="rotate({{:data.govAngle}} 60 60)"/>
			{{/if}}
			<line x1="60" y1="60" x2="60" y2="26" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" transform="rotate({{:data.rpmAngle}} 60 60)"/>
			<circle cx="60" cy="60" r="5" fill="#dddddd"/>
			<text x="60" y="86" text-anchor="middle" font-size="14" font-weight="bold" fill="#ffffff">{{:data.rpm}}</text>
			<text x="60" y="97" text-anchor="middle" font-size="8" fill="#aaaaaa">rpm</text>
		</svg>
		<div>
			Working window {{:data.rpmWindowLow}}-{{:data.rpmWindowHigh}} rpm (green), damage above red
			{{if data.governorOn && data.governorOk}}
				<br>Governor setting marked in yellow
			{{/if}}
		</div>
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Vibration:
	</div>
	<div class="itemContent">
		{{:helper.displayBar(data.vib, 0, data.vibMax, data.vibClass)}}
		<div class="statusValue">
			{{:data.vib}} mm/s
		</div>
		<div style="clear: both; padding-top: 2px;">
			<span class='{{:data.vibClass}}'><b>{{:data.vibText}}</b></span>, warning at {{:data.vibHigh}}, danger at {{:data.vibDanger}} mm/s
		</div>
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Steam power on the shaft:
	</div>
	<div class="itemContent">
		{{:data.steamKw}} kW
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Electric output:
	</div>
	<div class="itemContent">
		{{:helper.displayBar(data.outputKw, 0, data.maxKw, 'good')}}
		<div class="statusValue">
			{{:data.outputKw}} kW
		</div>
		<div style="clear: both; padding-top: 2px;">
			Grid asks {{:data.demandKw}} kW, generator rated {{:data.maxKw}} kW
		</div>
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Generator breaker:
	</div>
	<div class="itemContent">
		{{if data.breaker}}
			<span class='good'><b>CLOSED</b></span>
			{{:helper.link('Open breaker', 'unlocked', {'action' : 'breaker'})}}
		{{else}}
			<span class='average'><b>OPEN</b></span>
			{{:helper.link('Close breaker', 'locked', {'action' : 'breaker'}, data.hasGrid ? null : 'disabled')}}
			{{if data.tripReason}}
				<span class='bad'>&nbsp;tripped: {{:data.tripReason}}</span>
			{{/if}}
			{{if !data.hasGrid}}
				<span class='bad'>&nbsp;no grid cable</span>
			{{/if}}
		{{/if}}
	</div>
</div>

<h3>Steam path</h3>
<div class="item">
	<div class="itemLabel">
		Pressure, bar:
	</div>
	<div class="itemContent">
		before the turbine <b>{{:data.p0}}</b>, after HP <b>{{:data.p1}}</b>, after LP 1 <b>{{:data.p2}}</b>, at the condenser <b>{{:data.p3}}</b>
	</div>
</div>
{{for data.sections}}
<div class="item">
	<div class="itemLabel">
		{{:value.name}} section:
	</div>
	<div class="itemContent">
		{{if value.broken}}
			<span class='bad'><b>WRECKED</b></span>
		{{else}}
			{{:helper.displayBar(value.health, 0, 100, value.class)}}
			<div class="statusValue">
				{{:value.health}} %
			</div>
			<div style="clear: both; padding-top: 2px;">
				{{:value.flow}} mol/s, {{:value.kw}} kW
			</div>
		{{/if}}
	</div>
</div>
{{/for}}
<div class="item">
	<div class="itemLabel">
		Condenser:
	</div>
	<div class="itemContent">
		{{if data.hasCondenser}}
			takes {{:data.condenserFlow}} of {{:data.condenserMax}} mol/s
		{{else}}
			<span class='bad'>none connected</span>
		{{/if}}
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Relief valve:
	</div>
	<div class="itemContent">
		{{if data.hasRelief}}
			<span class='{{:data.reliefClass}}'><b>{{:data.reliefState}}</b></span>
			, opens at {{:data.reliefBar}} bar, dumping {{:data.reliefFlow}} mol/s
		{{else}}
			<span class='bad'>none connected, the reactor is protected by SCRAM only</span>
		{{/if}}
	</div>
</div>

<h3>Controls</h3>
<div class="item">
	<div class="itemLabel">
		Speed governor:
	</div>
	<div class="itemContent">
		{{if !data.governorOk}}
			<span class='bad'><b>FAILED</b></span>
		{{else}}
			{{if data.governorOn}}
				<span class='good'><b>ON</b></span>
			{{else}}
				<span class='average'><b>OFF, manual</b></span>
			{{/if}}
			{{:helper.link(data.governorOn ? 'Switch off' : 'Switch on', null, {'action' : 'gov_toggle'})}}
		{{/if}}
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Governor setting:
	</div>
	<div class="itemContent">
		<div class="statusValue">
			{{:data.governorSet}} rpm
		</div>
		{{:helper.link('-500', null, {'action' : 'gov_set', 'amount' : -500})}}
		{{:helper.link('+500', null, {'action' : 'gov_set', 'amount' : 500})}}
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Admission (inlet) valve:
	</div>
	<div class="itemContent">
		{{:helper.displayBar(data.effAdmission, 0, 100, 'good')}}
		<div class="statusValue">
			{{:data.effAdmission}} %
			{{if data.stopTripped}}
				<span class='bad'>stop valve shut</span>
			{{/if}}
		</div>
		<div style="clear: both; padding-top: 4px;">
			{{:helper.link('-10', null, {'action' : 'adm_move', 'amount' : -10}, (data.governorOn && data.governorOk) ? 'disabled' : null)}}
			{{:helper.link('-1', null, {'action' : 'adm_move', 'amount' : -1}, (data.governorOn && data.governorOk) ? 'disabled' : null)}}
			{{:helper.link('+1', null, {'action' : 'adm_move', 'amount' : 1}, (data.governorOn && data.governorOk) ? 'disabled' : null)}}
			{{:helper.link('+10', null, {'action' : 'adm_move', 'amount' : 10}, (data.governorOn && data.governorOk) ? 'disabled' : null)}}
		</div>
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Condenser cooling (exhaust):
	</div>
	<div class="itemContent">
		{{if data.hasCondenser}}
			{{:helper.displayBar(data.cooling, 0, 100, 'good')}}
			<div class="statusValue">
				{{:data.cooling}} %
			</div>
			<div style="clear: both; padding-top: 4px;">
				{{:helper.link('-10', null, {'action' : 'cool_move', 'amount' : -10}, (data.cooling > 0) ? null : 'disabled')}}
				{{:helper.link('-1', null, {'action' : 'cool_move', 'amount' : -1}, (data.cooling > 0) ? null : 'disabled')}}
				{{:helper.link('+1', null, {'action' : 'cool_move', 'amount' : 1}, (data.cooling < 100) ? null : 'disabled')}}
				{{:helper.link('+10', null, {'action' : 'cool_move', 'amount' : 10}, (data.cooling < 100) ? null : 'disabled')}}
			</div>
		{{else}}
			<span class='bad'>no condenser</span>
		{{/if}}
	</div>
</div>
<div class="item">
	<div class="itemLabel">
		Emergency:
	</div>
	<div class="itemContent">
		{{:helper.link('EMERGENCY STOP', 'alert', {'action' : 'stop_trip'}, data.stopTripped ? 'disabled' : null, 'redButton')}}
		{{:helper.link('Reset stop valve', 'unlocked', {'action' : 'stop_reset'}, data.stopTripped ? null : 'disabled')}}
		{{if data.stopTripped}}
			<span class='bad'>&nbsp;STOP VALVE SHUT, reset below 6000 rpm</span>
		{{/if}}
	</div>
</div>

<div class="item">
	<div class="itemLabel">
		Link:
	</div>
	<div class="itemContent">
		{{:helper.link('Rescan links', 'refresh', {'action' : 'rescan'})}}
	</div>
</div>
{{/if}}
