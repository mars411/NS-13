			{{:data.feedwater}} %
		</div>
		<div style="clear: both; padding-top: 4px;">
			{{:helper.link('Закрыть -10', 'triangle-1-s', {'action' : 'feed_down'}, (data.feedwater > 0) ? null : 'disabled')}}
			{{:helper.link('Открыть +10', 'triangle-1-n', {'action' : 'feed_up'}, (data.feedwater < 100) ? null : 'disabled')}}
		</div>
	</div>
</div>
{{/if}}
{{/if}}
{{if data.twoCircuit && data.hasPrimaryPump}}
